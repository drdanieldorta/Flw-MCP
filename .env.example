# ---- Obrigatório -----------------------------------------------------------
# Token permanente da API. Gere na plataforma em:
#   Ajustes > Integrações > Integração via API (Configurar) > Novo
# Formato: pn_xxxxxxxxxxxxxxxxxxxx
FLW_API_KEY=

# ---- Opcionais -------------------------------------------------------------
# URL base da API pública. Padrão: https://api.helena.run
# Alternativas equivalentes: https://api.flw.chat ou https://api.wts.chat
FLW_BASE_URL=https://api.helena.run

# Habilita flw_send_text e flw_send_template (envio real ao WhatsApp do contato).
# Desligado por padrão. Ligue só quando quiser que o assistente envie mensagens.
FLW_ENABLE_MESSAGING=false

# Habilita flw_request (chamadas HTTP arbitrárias à API). Só para exploração.
FLW_ALLOW_RAW_REQUESTS=false

# Timeout por requisição, em milissegundos (padrão 30000)
FLW_TIMEOUT_MS=30000

# Nível de log enviado ao stderr: debug | info | warn | error
FLW_LOG_LEVEL=info
