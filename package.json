{
  "name": "flw-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP (Model Context Protocol) para o CRM da plataforma FLW (Helena / WTS Chat). Instalável em qualquer máquina com um único comando.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drdanieldorta/Flw-MCP.git"
  },
  "bin": {
    "flw-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/config.test.mjs test/http.test.mjs test/server.test.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crm",
    "flw",
    "helena",
    "wts-chat",
    "whatsapp",
    "claude",
    "codex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/drdanieldorta/Flw-MCP#readme"
}
